# Fichier d'exemple de configuration — copier en .env et remplir les valeurs réelles
# Ne jamais committer le fichier .env

# Clé API pour l'authentification sur /api/chat et /api/health (R10)
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=CHANGEME_GENERATE_A_RANDOM_KEY_32_HEX_CHARS

# URL d'Ollama (défaut : localhost pour développement, http://ollama:11434 pour Docker)
OLLAMA_URL=http://localhost:11434

# Nom du modèle Ollama à utiliser
MODEL_NAME=phi3.5-financial

# Origine autorisée pour les requêtes CORS (R22)
ALLOWED_ORIGIN=http://localhost:8080
